<?xml version="1.0" encoding="UTF-8"?>
<!-- Runs devin-check.sh on weekday mornings at 9:30.
     Install:
       cp scripts/com.user.devin-check.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.user.devin-check.plist
     Set VISOR_AUTONOMOUS=1 in the EnvironmentVariables dict below to let
     Devin act on tasks rather than only remind. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.devin-check</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/sanketsrivastava/repos/visor/scripts/devin-check.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>VISOR_HOURS</key>
        <string>24</string>
    </dict>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/tmp/visor-devin-check.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/visor-devin-check.err</string>
</dict>
</plist>
